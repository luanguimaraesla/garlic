.PHONY: garliclint
garliclint:
	@echo "> Building garliclint"
	mkdir -p build
	$(GOBUILD) -o build/garliclint ./cmd/garliclint
	@echo "> Running garliclint"
	./build/garliclint ./...

# CI report mode. The multichecker binary exits 0 with no findings, 3 when
# diagnostics were reported, 1 on load or internal errors, 2 on usage errors,
# and above 128 on a signal or panic. This target passes on 0 (clean; the
# expected end state after remediation) and 3 (findings printed, report-only
# while remediation is tracked) and fails on anything else, so an analyzer
# crash cannot hide behind expected diagnostics.
.PHONY: garliclint-report
garliclint-report:
	@echo "> Building garliclint"
	mkdir -p build
	$(GOBUILD) -o build/garliclint ./cmd/garliclint
	@echo "> Running garliclint (report mode)"
	status=0; ./build/garliclint ./... || status=$$?; \
	if [ "$$status" -eq 0 ] || [ "$$status" -eq 3 ]; then \
		exit 0; \
	fi; \
	echo "garliclint exited $$status (analyzer crash or load error)" >&2; \
	exit "$$status"

.PHONY: garliclint-smoke
garliclint-smoke:
	bash internal/garliclint/scripts/downstream-smoke.sh

.PHONY: garliclint-makefile-security-test
garliclint-makefile-security-test:
	bash internal/garliclint/scripts/downstream-makefile-security-test.sh
